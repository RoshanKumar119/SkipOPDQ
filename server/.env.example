# Port for the Express + Socket.IO server
PORT=5000

# Optional: MongoDB connection string.
# Leave empty to automatically start an in-memory MongoDB (mongodb-memory-server)
# that is seeded with fresh demo data on every start.
MONGO_URI=

# Secret used to sign JWT tokens (change this in production)
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL (used for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173
